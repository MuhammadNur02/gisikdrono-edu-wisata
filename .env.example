# Copy to .env.local and fill in. Placeholders only: real values live in Vercel (Sensitive) and the vault.
# src/lib/env.ts and src/lib/public-env.ts validate every variable at boot (CLAUDE.md §10.2).

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `pnpm db:status`>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile site key; Cloudflare test key 1x00000000000000000000AA works locally>
NEXT_PUBLIC_WHATSAPP_CONTACT_NUMBER=<+628...>
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_FLAG_<NAME>=  build-time feature flags, read in src/config

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=<service role key from `pnpm db:status`>

# Locally and on previews these must be sandbox keys (SB-Mid-server-..., SB-Mid-client-...).
MIDTRANS_SERVER_KEY=<SB-Mid-server-...>
MIDTRANS_SERVER_KEY_PREVIOUS=
MIDTRANS_CLIENT_KEY=<SB-Mid-client-...>
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=<sandbox merchant id>
MIDTRANS_WEBHOOK_PATH_TOKEN=<openssl rand -base64 32 | tr '+/' '-_' | tr -d '='>

# Required in production only; previews use a stub adapter.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=<openssl rand -hex 32>

RESEND_API_KEY=<resend api key>
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=<Edu Wisata Gisikdrono <noreply@mail.your-domain>>

QR_SIGNING_KEYS=<{"k1":"<openssl rand -base64 32>"}>
QR_SIGNING_ACTIVE_KID=k1
BOOKING_LINK_SECRET=<openssl rand -hex 32>
OTP_PEPPER=<openssl rand -hex 32>
PARTICIPANT_PII_KEYS=
PARTICIPANT_PII_ACTIVE_KID=
CRON_SECRET=<openssl rand -hex 32>
TURNSTILE_SECRET_KEY=<turnstile secret; Cloudflare test key 1x0000000000000000000000000000000AA works locally>

SECURITY_ALERT_EMAIL=<keamanan@your-domain>
SECURITY_ALERT_WA_PHONE=<+628...>

# --- CI only (GitHub Actions secrets, never in .env.local) ---
# SUPABASE_DB_URL, SUPABASE_ACCESS_TOKEN, SENTRY_AUTH_TOKEN, BACKUP_AGE_PUBLIC_KEY, R2_*
