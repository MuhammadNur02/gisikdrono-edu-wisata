{
  "name": "gisikdrono-edu-wisata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:rls": "supabase test db supabase/tests/rls_*.sql && vitest run --project integration tests/integration/rls-http.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:table-tests && pnpm db:types:check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && pnpm db:seed && pnpm db:types",
    "db:migrate:new": "supabase migration new",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push --linked",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:types:check": "pnpm db:types && git diff --exit-code -- src/db/types.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:test": "supabase test db",
    "midtrans:simulate": "tsx scripts/midtrans-simulate.ts",
    "midtrans:status": "tsx scripts/midtrans-status.ts",
    "midtrans:check": "tsx scripts/midtrans-check.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "wa:send-test": "tsx scripts/wa-send-test.ts",
    "email:preview": "email dev --dir src/lib/email",
    "check:secrets": "node scripts/check-client-bundle-secrets.mjs",
    "check:table-tests": "node scripts/check-table-tests.mjs",
    "analyze": "next build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.14",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "file-type": "^22.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "page-flip": "2.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.5.28",
    "@playwright/test": "^1.64.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.11.1",
    "schema-dts": "^2.1.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
